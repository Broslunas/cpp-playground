# GitHub OAuth Application
# Obtén tus credenciales en: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=https://ejecuta.tech

# Sesión segura (Clave secreta de al menos 32 caracteres para firmar JWT)
SESSION_SECRET=super-secret-random-key-change-this-in-production-min-32-chars-6767

# MongoDB (Atlas o instancia local)
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Cloudflare R2 (Almacenamiento S3 compatible para código)
# Crea un bucket en Cloudflare Dashboard -> R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
